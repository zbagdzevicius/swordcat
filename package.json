{
  "name": "swordcat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prune-assets.mjs && node scripts/bundle-budget.mjs dist",
    "glb:optimize": "node scripts/optimize-glb.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test:unit": "node --import ./tests/unit/_setup.mjs --test \"tests/unit/**/*.test.js\"",
    "smoke": "node tests/smoke.mjs",
    "check": "npm run build && npm run test:unit && npm run smoke"
  },
  "dependencies": {
    "three": "0.186.1",
    "zzfx": "1.4.0"
  },
  "devDependencies": {
    "vite": "8.3.3",
    "playwright": "1.63.0"
  }
}
